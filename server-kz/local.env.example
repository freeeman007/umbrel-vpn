# Образец локального конфига для скриптов server-kz.
# Скопировать в /root/antizapret/local.env, вписать свои значения, права 600:
#   install -m 600 local.env.example /root/antizapret/local.env
# В репозиторий этот файл не попадает (.gitignore).

# Подсеть домашней сети, куда клиенты VPN ходят через Umbrel (CIDR).
# Пусто — правила «в домашнюю сеть» не ставятся.
HOME_LAN=

# Имя tun-интерфейса OpenVPN-сервера (нужно umbrel-lan-route.sh).
OVPN_IF=antizapret-udp

# Для самопроверки из README (на работу скриптов не влияет).
# UMBREL_TUNNEL_IP=
# HOME_HOST=
# HOME_GW=
