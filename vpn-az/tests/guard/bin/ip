#!/bin/sh
echo "IP $*" >> "$LOG"
ST="${IPT_STATE:-$PWD/iptstate}"; mkdir -p "$ST"
C="$ST/iprule_cnt"
case "$*" in
  *"rule add"*) n=$(( $(cat "$C" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$C"; exit 0 ;;
  *"rule del"*) n=$(cat "$C" 2>/dev/null || echo 0)
                if [ "$n" -gt 0 ]; then echo $((n-1)) > "$C"; exit 0; fi
                exit 1 ;;
  *"link show azvpn"*) [ "${FAKE_TUN:-0}" = 1 ] && exit 0 || exit 1 ;;
  *"link show wg0"*) exit 1 ;;
  *"route show dev azvpn"*) [ "${FAKE_TUN:-0}" = 1 ] && echo "${FAKE_ROUTES:-}" ; exit 0 ;;
  *"route show dev wg0"*) exit 0 ;;
  *"-4 -o addr show dev azvpn"*) echo "${FAKE_TUNIP:-}" ; exit 0 ;;
esac
exit 0
